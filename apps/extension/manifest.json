{
  "manifest_version": 3,
  "name": "Nova Quick Chat",
  "version": "0.1.0",
  "description": "Open Nova in a small floating chat window from anywhere — it stays open after you close the Nova tab.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Nova Quick Chat",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage"],
  "options_page": "options.html",
  "commands": {
    "toggle-quick-chat": {
      "suggested_key": { "default": "Ctrl+Shift+1", "mac": "Command+Shift+1" },
      "description": "Show or hide Nova Quick Chat",
      "global": true
    }
  }
}
