# =====================================================================
# NOVA AI — environment template (development defaults)
# Copy to .env and fill in values. NEVER commit .env or real secrets.
# Full reference: docs/42_ENVIRONMENT_VARIABLES.md
# Values marked CHANGE_ME must be replaced (generate with `make secrets`).
# =====================================================================

# --- Core -------------------------------------------------------------
APP_ENV=development
APP_URL=http://localhost:3000
APP_VERSION=dev
LOG_LEVEL=info
LOG_FORMAT=console
API_INTERNAL_URL=http://api:8000
API_PROXY_SHARED_SECRET=CHANGE_ME_generate_32_plus_random_bytes
AUTH_SECRET=CHANGE_ME_generate_32_plus_random_bytes
AUTH_SECRET_PREVIOUS=
COOKIE_DOMAIN=
SESSION_TTL_DAYS=30
SESSION_IDLE_TIMEOUT_DAYS=7
ADMIN_BOOTSTRAP_EMAIL=
WEB_CONCURRENCY=2
WORKER_MAX_JOBS=8
WORKER_EXTRACT_PROCESSES=2
RATE_LIMIT_FALLBACK_DIVISOR=4

# --- Database & Redis -------------------------------------------------
DATABASE_URL=postgresql+asyncpg://nova:nova@postgres:5432/nova
# Host ports for the Docker Postgres/Redis (change if 5432/6379 are taken on your machine).
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
DATABASE_MIGRATOR_URL=
DATABASE_READ_REPLICA_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
DATABASE_USE_PGBOUNCER=false
REDIS_URL=redis://redis:6379/0

# --- Groq (the ONLY LLM provider; server-side only) --------------------
# BYOK: users enter their own Groq key when they start each chat (GROQ_KEY_MODE=user).
# Set GROQ_KEY_MODE=server and GROQ_API_KEY to use one server-held key instead.
GROQ_KEY_MODE=user
GROQ_USER_KEY_TTL_HOURS=720
GROQ_API_KEY=
# Model IDs: copy from current Groq documentation. Do not guess.
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=
GROQ_VISION_MODEL=
GROQ_STT_MODEL=
GROQ_TTS_MODEL=
GROQ_TTS_VOICES=
GROQ_TTS_DEFAULT_VOICE=
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2
GROQ_MAX_CONCURRENCY_PER_PROCESS=64
# Test-only override (rejected in staging/production):
GROQ_BASE_URL=
MODEL_REGISTRY_PATH=config/models.yaml

# --- Embeddings (self-hosted TEI; independent of Groq) -----------------
EMBEDDING_PROVIDER=tei
EMBEDDING_ENDPOINT=http://embeddings:80
# Choose an open-weights embedding model and set its output dimension.
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
RERANKER_ENDPOINT=
RAG_SIM_THRESHOLD=0.25
RAG_TOP_K_VECTOR=40
RAG_TOP_K_FTS=40
RAG_FINAL_MAX_CHUNKS=8
RAG_MMR_LAMBDA=0.7

# --- Object storage (S3-compatible; RustFS in dev) --------------------
S3_ENDPOINT=http://storage:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nova-dev
S3_ACCESS_KEY=CHANGE_ME_dev_storage_user
S3_SECRET_KEY=CHANGE_ME_dev_storage_password_min_8_chars
S3_FORCE_PATH_STYLE=true

# --- Malware scanning --------------------------------------------------
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Tools -------------------------------------------------------------
WEB_SEARCH_PROVIDER=none
SEARXNG_URL=http://searxng:8080
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_GLOBAL_RPS=10
WEB_SEARCH_COST_PER_QUERY_USD_MICROS=
SANDBOX_RUNNER_URL=
SANDBOX_RUNNER_TOKEN=CHANGE_ME_generate_32_plus_random_bytes
SANDBOX_RUNTIME=runc
SANDBOX_IMAGE=nova-sandbox-python:dev
SANDBOX_MAX_CONCURRENCY=8
SANDBOX_DOCKER_HOST=unix:///var/run/docker.sock

# --- Voice -------------------------------------------------------------
VOICE_STT_PROVIDER=
VOICE_TTS_PROVIDER=

# --- Email (Mailpit in dev) -------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=NOVA AI <no-reply@localhost>
SMTP_USE_TLS=false

# --- Observability -----------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME is set per service in docker-compose.yml (nova-api, nova-worker, nova-web, nova-sandbox-runner)
# SENTRY_AUTH_TOKEN is CI-only (source map upload) and must not be set here
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# --- Public (browser) variables: ONLY these may be NEXT_PUBLIC_ --------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NOVA AI
NEXT_PUBLIC_SENTRY_DSN=

# --- Evaluation (CI/nightly only) --------------------------------------
EVAL_API_KEY=
EVAL_MAX_COST_USD=20
STAGING_URL=

# Per-IP request ceiling (all endpoints). Raise only for load tests from few IPs.
RATE_LIMIT_GLOBAL_IP_PER_MIN=300
